{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Personal Affairs",
  "version": "0.3.0",
  "identifier": "com.myfinance.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "My Personal Affairs",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBMDJBRTMwQjFBNjdCMUIKUldRYmU2YXhNSzRDK2dnYUNxTU1ONTJHeVBDS1JkSXdaUGJXMGRuZ0F2Qk5mVG1sTnBIamdpRUwK",
      "endpoints": [
        "https://github.com/LiuAlfredo/Myfinance/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
